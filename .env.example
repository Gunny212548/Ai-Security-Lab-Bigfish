APP_SECRET=change-me
ADMIN_PASSWORD=change-me
DEFAULT_PROVIDER=cloud
# several keys, comma-separated: the app switches to the next one when a key is rate-limited or used up
GROQ_API_KEY=
LLM_TEMPERATURE=0.3
LLM_SEED=42
LLM_MAX_TOKENS=400
HISTORY_TURNS=6
RATE_LIMIT_PER_MIN=6
FAST_SOLVE_SECONDS=90
PER_TEAM_FLAGS=true
# activity log (what players do): stdout + this file; empty = Docker logs only
LOG_LEVEL=INFO
# ACTIVITY_LOG_FILE=/app/data/activity.log
# Caddy (HTTPS + basic auth). PUBLIC_PORT = the external HTTPS port the router forwards to this server
# (same number on both sides). Porkbun: Account > API Access, and turn on "API Access" for the domain.
PUBLIC_PORT=8000
PORKBUN_API_KEY=
PORKBUN_API_SECRET_KEY=
