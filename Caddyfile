{
	auto_https disable_redirects # only PUBLIC_PORT is mapped; no HTTP->HTTPS redirect on :80
}

# Players open https://lab.bigfishai.lat:<PUBLIC_PORT>. The ISP blocks inbound 80/443, so Let's Encrypt
# cannot issue a certificate: Caddy signs its own (tls internal). Browsers warn once; players click
# Advanced > Proceed.
lab.bigfishai.lat:{$PUBLIC_PORT:8000} {
	tls internal
	basic_auth {
		admin $2a$14$rx7TUyRX9iS0/eRiewDUjelbfF3J9vzqMW1uhzD4KSlNNBa5p7agW
	}
	reverse_proxy app:8000
}
