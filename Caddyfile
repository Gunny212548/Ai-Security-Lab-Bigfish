# Players open https://lab.bigfishai.lat:<PUBLIC_PORT>. The ISP blocks inbound 80/443, so the
# certificate comes from a DNS-01 challenge through the Porkbun API (keys in .env).
lab.bigfishai.lat:{$PUBLIC_PORT:8000} {
	tls {
		dns porkbun {
			api_key {env.PORKBUN_API_KEY}
			api_secret_key {env.PORKBUN_API_SECRET_KEY}
		}
		resolvers 1.1.1.1 1.0.0.1
	}
	basic_auth {
		admin $2a$14$rx7TUyRX9iS0/eRiewDUjelbfF3J9vzqMW1uhzD4KSlNNBa5p7agW
	}
	reverse_proxy app:8000
}
